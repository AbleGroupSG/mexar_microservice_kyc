# Laravel Environment Configuration
# Copy to .env for local Docker development
#
# Note: Docker-specific variables (DB_ROOT_PASSWORD, PUBLIC_DOMAIN, etc.)
# are configured in .env.docker - see .env.docker.example

APP_NAME="KYC MSA Service"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=https://kyc.local

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database (container hostname for Docker)
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=mexar_kyc_msa
DB_USERNAME=root
DB_PASSWORD=your-password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Redis (container hostname for Docker)
CACHE_STORE=redis
CACHE_PREFIX=kycmsa_cache_

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# MEXAR Integration
MEXAR_URL=http://localhost:8000
MEXAR_KEY_SECRET=

# RegTank KYC Provider
COMPANY_SPECIFIC_REGTANK_SERVICE_URL=
REGTANK_CRM_SERVER_URL=
CLIENT_ID_TEMPLATE=
CLIENT_SECRET_TEMPLATE=
REGTANK_ASIGNEE=

# GlairAI OCR Provider
GLAIR_OCR_BASE_URL=
GLAIR_API_KEY=
GLAIR_USERNAME=
GLAIR_PASSWORD=

# Sijitu Biometric Provider
SIJITU_BASE_URL=https://sandbox-api.espay.id
SIJITU_AUTHORIZATION=
SIJITU_USERNAME=
SIJITU_PASSWORD=
SIJITU_SENDER_ID=
SIJITU_USER_ID=
SIJITU_ORGANIZATION_ID=
SIJITU_SIGNATURE_KEY=

VITE_APP_NAME="${APP_NAME}"

# Dashboard (Livewire admin panel)
DASHBOARD_ENABLED=true
